{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songyear-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8000,http://localhost:8000"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SONGYEAR_ROOM", "class_name": "SongYearRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SongYearRoom"] }
  ]
}
