# URL pública do Worker, sem barra final. Ex.: ws://127.0.0.1:8787
NEXT_PUBLIC_GAME_WS_URL=

# Cache compartilhado de previews (opcional localmente)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Apenas para /dev/deck
GENIUS_ACCESS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/dev/spotify/callback

# Mantém o Deck Studio fechado em produção, salvo ativação explícita.
ENABLE_DECK_STUDIO=false
