# URL pública do Worker, sem barra final. Em branco, usa /game-worker na mesma origem.
NEXT_PUBLIC_GAME_WS_URL=

# Hostnames adicionais para acessar o Next dev (sem protocolo ou porta)
DEV_ORIGINS=*.trycloudflare.com

# Cache compartilhado de previews (opcional localmente)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Apenas para /dev/deck
GENIUS_ACCESS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# Mantém o Deck Studio fechado em produção, salvo ativação explícita.
ENABLE_DECK_STUDIO=false
